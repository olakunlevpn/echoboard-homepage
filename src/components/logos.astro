---
// @ts-ignore
import { Icon } from "astro-icon";
---

<div class="mt-36 mb-36">
  <h2 class="text-center text-slate-500">Modern technologies</h2>
  <div class="flex gap-8 md:gap-20 items-center justify-center mt-10 flex-wrap">
    <Icon class="h-8 md:h-12" name="logos:laravel" />
    <Icon class="h-8 md:h-12" name="logos:bootstrap" />
    <Icon class="h-8 md:h-14" name="simple-icons:livewire" />
    <Icon class="h-8 md:h-16" name="simple-icons:alpinedotjs" />
    <Icon class="h-8 md:h-12" name="logos:javascript" />
    <Icon class="h-8 md:h-12" name="logos:mysql" />
  </div>
</div>
